diff --git a/CMakeLists.txt b/CMakeLists.txt
index b69ec9fb..52275944 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -182,6 +182,18 @@ else(SPIRV_TOOLS_BUILD_STATIC)
   endif()
 endif(SPIRV_TOOLS_BUILD_STATIC)
 
+# Defines the export macros of a shared library (see libspirv.h):
+# ${PREFIX}_IMPLEMENTATION while building it and ${PREFIX}_SHAREDLIB for it and
+# its consumers, so that its API is dllexport'ed and dllimport'ed on Windows.
+function(spvtools_export_macros TARGET PREFIX)
+  get_target_property(type ${TARGET} TYPE)
+  if (type STREQUAL "SHARED_LIBRARY")
+    target_compile_definitions(${TARGET}
+      PRIVATE ${PREFIX}_IMPLEMENTATION
+      PUBLIC ${PREFIX}_SHAREDLIB)
+  endif()
+endfunction()
+
 function(spvtools_default_compile_options TARGET)
   target_compile_options(${TARGET} PRIVATE ${SPIRV_WARNINGS})
 
diff --git a/include/spirv-tools/libspirv.h b/include/spirv-tools/libspirv.h
index 96abf42e..113fe892 100644
--- a/include/spirv-tools/libspirv.h
+++ b/include/spirv-tools/libspirv.h
@@ -48,6 +48,59 @@ extern "C" {
 #define SPIRV_TOOLS_LOCAL
 #endif
 
+// Export macros for the C++ libraries layered on top of SPIRV-Tools. When
+// SPIRV_TOOLS_LIBRARY_TYPE is SHARED, each of them is a separate shared
+// library (DLL on Windows). The CMake targets define SPIRV_TOOLS_<LIB>_SHAREDLIB
+// publicly and SPIRV_TOOLS_<LIB>_IMPLEMENTATION while building the library, so
+// that consumers get __declspec(dllimport) and the library dllexport.
+#if defined(_WIN32)
+#define SPIRV_TOOLS_DLLEXPORT_ __declspec(dllexport)
+#define SPIRV_TOOLS_DLLIMPORT_ __declspec(dllimport)
+#else
+#define SPIRV_TOOLS_DLLEXPORT_ __attribute__((visibility("default")))
+#define SPIRV_TOOLS_DLLIMPORT_
+#endif
+
+#if !defined(SPIRV_TOOLS_OPT_SHAREDLIB)
+#define SPIRV_TOOLS_OPT_EXPORT
+#elif defined(SPIRV_TOOLS_OPT_IMPLEMENTATION)
+#define SPIRV_TOOLS_OPT_EXPORT SPIRV_TOOLS_DLLEXPORT_
+#else
+#define SPIRV_TOOLS_OPT_EXPORT SPIRV_TOOLS_DLLIMPORT_
+#endif
+
+#if !defined(SPIRV_TOOLS_LINK_SHAREDLIB)
+#define SPIRV_TOOLS_LINK_EXPORT
+#elif defined(SPIRV_TOOLS_LINK_IMPLEMENTATION)
+#define SPIRV_TOOLS_LINK_EXPORT SPIRV_TOOLS_DLLEXPORT_
+#else
+#define SPIRV_TOOLS_LINK_EXPORT SPIRV_TOOLS_DLLIMPORT_
+#endif
+
+#if !defined(SPIRV_TOOLS_LINT_SHAREDLIB)
+#define SPIRV_TOOLS_LINT_EXPORT
+#elif defined(SPIRV_TOOLS_LINT_IMPLEMENTATION)
+#define SPIRV_TOOLS_LINT_EXPORT SPIRV_TOOLS_DLLEXPORT_
+#else
+#define SPIRV_TOOLS_LINT_EXPORT SPIRV_TOOLS_DLLIMPORT_
+#endif
+
+#if !defined(SPIRV_TOOLS_REDUCE_SHAREDLIB)
+#define SPIRV_TOOLS_REDUCE_EXPORT
+#elif defined(SPIRV_TOOLS_REDUCE_IMPLEMENTATION)
+#define SPIRV_TOOLS_REDUCE_EXPORT SPIRV_TOOLS_DLLEXPORT_
+#else
+#define SPIRV_TOOLS_REDUCE_EXPORT SPIRV_TOOLS_DLLIMPORT_
+#endif
+
+#if !defined(SPIRV_TOOLS_DIFF_SHAREDLIB)
+#define SPIRV_TOOLS_DIFF_EXPORT
+#elif defined(SPIRV_TOOLS_DIFF_IMPLEMENTATION)
+#define SPIRV_TOOLS_DIFF_EXPORT SPIRV_TOOLS_DLLEXPORT_
+#else
+#define SPIRV_TOOLS_DIFF_EXPORT SPIRV_TOOLS_DLLIMPORT_
+#endif
+
 // Helpers
 
 #define SPV_BIT(shift) (1 << (shift))
@@ -351,7 +404,7 @@ typedef enum spv_operand_type_t {
 bool spvOperandIsConcrete(spv_operand_type_t type);
 
 // Returns true if the given type is concrete and also a mask.
-bool spvOperandIsConcreteMask(spv_operand_type_t type);
+SPIRV_TOOLS_EXPORT bool spvOperandIsConcreteMask(spv_operand_type_t type);
 
